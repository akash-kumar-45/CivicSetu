# Environment Configuration Template
# Cooperative Gig Services Platform

# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/cooperative_db?sslmode=require"

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-this-to-a-secure-random-32-byte-secret-in-production"

# App Environment
NODE_ENV="development"
PORT=3000

{
  "name": "cooperative-gig-services-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Cooperative Gig Services Platform for Household & Community Services",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "test:watch": "npm run test:watch --workspace=backend",
    "prisma:generate": "npm run prisma:generate --workspace=backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=backend",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "cooperative",
    "time-credits",
    "community-services",
    "nextjs",
    "prisma",
    "tailwind"
  ],
  "author": "Atharva",
  "license": "MIT"
}
